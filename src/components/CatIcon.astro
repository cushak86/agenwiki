---
// 카테고리 아이콘 (KB Think의 카테고리 도형처럼 작은 색 도형)
interface Props { shape: string; color?: string; size?: number }
const { shape, color = 'currentColor', size = 16 } = Astro.props;
---
<svg class="cat-icon" width={size} height={size} viewBox="0 0 20 20" aria-hidden="true">
  {shape === 'square' && <rect x="2" y="2" width="16" height="16" rx="5" fill={color} />}
  {shape === 'drop' && <path d="M10 1.5c3.8 4.3 7 7.9 7 11a7 7 0 0 1-14 0c0-3.1 3.2-6.7 7-11Z" fill={color} />}
  {shape === 'hex' && <path d="M10 1.5 17.4 5.8v8.4L10 18.5l-7.4-4.3V5.8Z" fill={color} stroke={color} stroke-width="1.6" stroke-linejoin="round" />}
  {shape === 'heart' && <path d="M10 17.5S2 12.6 2 7.1A4.3 4.3 0 0 1 10 4.9a4.3 4.3 0 0 1 8 2.2c0 5.5-8 10.4-8 10.4Z" fill={color} />}
</svg>
