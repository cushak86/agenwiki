---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return CATEGORIES.map((cat) => ({
    params: { category: cat.slug },
    props: {
      cat,
      posts: posts
        .filter((p) => p.data.category === cat.slug)
        .sort((a, b) => Number(b.data.pillar) - Number(a.data.pillar) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id)),
    },
  }));
}

const { cat, posts } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' });
const description = `${cat.label} 분야 정부지원금과 공공기관 혜택의 자격 요건, 지급액, 신청 방법 가이드 모음. ${cat.desc}을 공식 자료 기준으로 정리합니다.`;
---
<BaseLayout title={`${cat.label} 지원금·혜택 가이드`} description={description}>
  <section class="hero">
    <h1>{cat.label}</h1>
    <p>{cat.desc}을 공식 자료 기준으로 정리했습니다.</p>
  </section>

  {posts.length === 0 ? (
    <p class="meta" style="padding:32px 0">아직 등록된 글이 없습니다.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
          <p class="excerpt">{post.data.description}</p>
          <p class="meta"><span>공식 자료 확인 {fmt(post.data.verifiedDate)}</span><span>{post.data.agency.name}</span></p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
